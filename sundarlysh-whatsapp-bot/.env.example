# Copy to .env and fill in. Never commit the real .env.

# --- WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup) ---
WHATSAPP_PHONE_NUMBER_ID=          # "Phone number ID" (not the phone number itself)
WHATSAPP_ACCESS_TOKEN=             # permanent System User token with whatsapp_business_messaging
WHATSAPP_APP_SECRET=               # App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=             # any random string; paste the same value in the webhook settings
GRAPH_API_VERSION=v24.0

# --- Team ---
ADMIN_NUMBERS=91XXXXXXXXXX         # team WhatsApp numbers for alerts/commands, comma-separated, with country code
ADMIN_DASHBOARD_TOKEN=             # long random string; open https://<your-server>/admin?token=<this>

# --- Optional: approved templates for messages sent outside WhatsApp's 24-hour window ---
ADMIN_ALERT_TEMPLATE=              # e.g. new_booking_alert   (body: {{1}} = booking ref, {{2}} = summary)
CUSTOMER_UPDATE_TEMPLATE=          # e.g. booking_update      (body: {{1}} = name, {{2}} = ref, {{3}} = status)
TEMPLATE_LANGUAGE=en

# --- Server ---
PORT=3000
DB_PATH=./data/bookings.db
